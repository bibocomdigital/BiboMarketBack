#Server port
PORT=3000

# Utilisé par l'application
DATABASE_URL=postgresql://waxciuser:monmotdepasse@ep-cool-river-a1b2c3-pooler.eu-west-3.aws.neon.tech/waxci?sslmode=require

# Utilisé par Prisma Migrate
DIRECT_URL=postgresql://waxciuser:monmotdepasse@ep-cool-river-a1b2c3.eu-west-3.aws.neon.tech/waxci?sslmode=require

# Docker Compose (postgres local) — à utiliser si l'app tourne sur l'hôte
# contre le Postgres du compose (le service backend surcharge déjà ces URLs) :
# DATABASE_URL=postgresql://bibouser:bibopassword@localhost:5438/biboMarket
# DIRECT_URL=postgresql://bibouser:bibopassword@localhost:5438/biboMarket

# Redis — cache des connexions Socket (userId -> socketId)
REDIS_URL=redis://localhost:6379

# Google OAuth
# Callback URI à enregistrer dans la console Google (doit correspondre à ce qui est configuré).
GOOGLE_CALLBACK_URL=http://localhost:3007/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_FLUTTER=
GOOGLE_CLIENT_IDS=

# SMS — Orange par défaut si configuré, sinon console (logs)
# SMS_PROVIDER=console | orange | http
SMS_PROVIDER=console
SMS_ENABLED=false
SMS_SENDER_ID=Bibocomdigital

# Orange SMS API (contrainte : SMS_PROVIDER=orange)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
# Header Authorization complet, ou construit depuis ORANGE_CLIENT_ID/SECRET
ORANGE_AUTH_HEADER=
ORANGE_TOKEN_URL=https://api.orange.com/oauth/v3/token
ORANGE_SMS_BASE_URL=https://api.orange.com/smsmessaging/v1
# Numéro court émetteur, ex: 2210000 (Sénégal)
ORANGE_SENDER_NUMBER=
# Nom émetteur whitelisté uniquement (sinon laisser vide)
ORANGE_SENDER_NAME=

# Passerelle HTTP générique (contrainte : SMS_PROVIDER=http)
SMS_API_URL=
SMS_API_KEY=
SMS_HTTP_METHOD=POST
SMS_CONTENT_TYPE=application/json
SMS_AUTH_HEADER=Authorization
SMS_AUTH_PREFIX=Bearer
SMS_FIELD_TELEPHONE=to
SMS_FIELD_MESSAGE=message
SMS_FIELD_SENDER=sender
SMS_BODY_TEMPLATE=
SMS_HEADERS_JSON=

# Stockage — images/avatars → Cloudinary, vidéos/audio → Bunny
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
BUNNY_STORAGE_ZONE=
BUNNY_API_KEY=
BUNNY_CDN_HOST=